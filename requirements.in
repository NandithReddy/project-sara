# Direct dependencies. Compile to pinned requirements.txt with:
#   uv pip compile requirements.in -o requirements.txt
#
# Deps arrive with the phase that first imports them, never earlier
# (ENGINEERING.md rule 5: ask before adding a dependency).

# --- Tier A: tooling ---
pytest         # test runner
ruff           # linter + formatter in one binary (replaces flake8 + black + isort)

# --- Phase 1b: live audio path ---
sounddevice    # mic capture via PortAudio; the only maintained option that streams
numpy          # audio buffers; every audio lib below speaks ndarray
onnxruntime    # CPU inference for Silero VAD now, and the EOT model in Phase 4.
               # Chosen over the silero-vad package, which pulls torch +
               # torchaudio (16 packages, GBs) to run a 1.8MB model.
soundfile      # read/write WAV, so the VAD can be verified offline without a mic

# --- Phase 1c: streaming STT, live path only ---
# Apple Silicon only, so it carries a marker: without one, `make install` breaks
# for anyone cloning this on Linux. Section 10 keeps the eval path off any STT,
# so the actual deliverable stays reproducible on every platform -- only the
# demo is Mac-only.
parakeet-mlx; sys_platform == "darwin" and platform_machine == "arm64"

# TTS on the live path is macOS /usr/bin/say -- no dependency.
